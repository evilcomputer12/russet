    "menus": {
      "commandPalette": [
        {
          "command": "russet.device.setRunDestination",
          "when": "false"
        },
        {
          "command": "russet.device.pair",
          "when": "russet.hasDevice"
        },
        {
          "command": "russet.device.mountDdi",
          "when": "russet.hasDevice"
        },
        {
          "command": "russet.device.revealDeveloperMode",
          "when": "russet.hasDevice"
        },
        {
          "command": "russet.device.copyUdid",
          "when": "russet.hasDevice"
        },
        {
          "command": "russet.hotReload",
          "when": "russet.canHotReload"
        },
        {
          "command": "russet.hotRestart",
          "when": "russet.isRunning"
        },
        {
          "command": "russet.stop",
          "when": "russet.isRunning"
        },
        {
          "command": "russet.virtual.home",
          "when": "russet.virtualIphoneOpen"
        },
        {
          "command": "russet.virtual.lock",
          "when": "russet.virtualIphoneOpen"
        },
        {
          "command": "russet.virtual.volumeUp",
          "when": "russet.virtualIphoneOpen"
        },
        {
          "command": "russet.virtual.volumeDown",
          "when": "russet.virtualIphoneOpen"
        },
        {
          "command": "russet.virtual.rotateLeft",
          "when": "russet.virtualIphoneOpen"
        },
        {
          "command": "russet.virtual.rotateRight",
          "when": "russet.virtualIphoneOpen"
        },
        {
          "command": "russet.virtual.screenshot",
          "when": "russet.virtualIphoneOpen"
        },
        {
          "command": "russet.apple.openPlist",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "russet.run",
          "group": "russet@1",
          "when": "russet.projectKind && !russet.isRunning"
        },
        {
          "command": "russet.debug",
          "group": "russet@2",
          "when": "russet.projectKind"
        },
        {
          "command": "russet.hotReload",
          "group": "russet@3",
          "when": "russet.canHotReload"
        },
        {
          "command": "russet.stop",
          "group": "russet@4",
          "when": "russet.isRunning"
        }
      ],
      "view/title": [
        {
          "command": "russet.run",
          "when": "view == russet.devices",
          "group": "navigation@1"
        },
        {
          "command": "russet.debug",
          "when": "view == russet.devices",
          "group": "navigation@2"
        },
        {
          "command": "russet.stop",
          "when": "view == russet.devices && russet.isRunning",
          "group": "navigation@3"
        },
        {
          "command": "russet.hotReload",
          "when": "view == russet.devices && russet.canHotReload",
          "group": "navigation@4"
        },
        {
          "command": "russet.devices.refresh",
          "when": "view == russet.devices",
          "group": "navigation@9"
        },
        {
          "command": "russet.project.new",
          "when": "view == russet.project",
          "group": "navigation@1"
        },
        {
          "command": "russet.signing.refresh",
          "when": "view == russet.signing",
          "group": "navigation@1"
        },
        {
          "command": "russet.openVirtualIphone",
          "when": "view == russet.mirror",
          "group": "navigation@1"
        }
      ],
      "russet/titleBar": [
        {
          "command": "russet.run",
          "group": "navigation@1"
        },
        {
          "command": "russet.debug",
          "group": "navigation@2"
        },
        {
          "command": "russet.stop",
          "group": "navigation@3"
        },
        {
          "command": "russet.hotReload",
          "group": "navigation@4"
        },
        {
          "command": "russet.selectTarget",
          "group": "navigation@5"
        },
        {
          "command": "russet.selectDevice",
          "group": "navigation@6"
        }
      ],
      "view/item/context": [
        {
          "command": "russet.device.setRunDestination",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "1_run@1"
        },
        {
          "command": "russet.device.pair",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "2_setup@1"
        },
        {
          "command": "russet.device.mountDdi",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "2_setup@2"
        },
        {
          "command": "russet.device.revealDeveloperMode",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "2_setup@3"
        },
        {
          "command": "russet.openConsole",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "3_view@1"
        },
        {
          "command": "russet.openMirror",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "3_view@2"
        },
        {
          "command": "russet.takeScreenshot",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "3_view@3"
        },
        {
          "command": "russet.device.installApp",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "4_apps@1"
        },
        {
          "command": "russet.device.copyUdid",
          "when": "view == russet.devices && viewItem == russet.device",
          "group": "9_clipboard@1"
        },
        {
          "command": "russet.run",
          "when": "view == russet.runConfigs && viewItem == russet.runConfig",
          "group": "inline@1"
        },
        {
          "command": "russet.debug",
          "when": "view == russet.runConfigs && viewItem == russet.runConfig",
          "group": "inline@2"
        },
        {
          "command": "russet.signing.fix",
          "when": "view == russet.signing && viewItem == russet.signingProblem",
          "group": "inline@1"
        }
      ],
      "explorer/context": [
        {
          "command": "russet.openAssetCatalog",
          "when": "explorerResourceIsFolder && resourceExtname == .xcassets"
        },
        {
          "command": "russet.openCapabilities",
          "when": "resourceExtname == .entitlements"
        },
        {
          "command": "russet.apple.openPlist",
          "when": "resourceExtname =~ /^\\.(plist|strings|nib|mobileprovision|provisionprofile)$/",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "russet.virtual.home",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == 'russet.virtualIphone'"
        },
        {
          "command": "russet.virtual.rotateLeft",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == 'russet.virtualIphone'"
        },
        {
          "command": "russet.virtual.rotateRight",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == 'russet.virtualIphone'"
        },
        {
          "command": "russet.virtual.screenshot",
          "group": "navigation@4",
          "when": "activeWebviewPanelId == 'russet.virtualIphone'"
        },
        {
          "command": "russet.virtual.lock",
          "group": "1_hardware@1",
          "when": "activeWebviewPanelId == 'russet.virtualIphone'"
        },
        {
          "command": "russet.virtual.volumeUp",
          "group": "1_hardware@2",
          "when": "activeWebviewPanelId == 'russet.virtualIphone'"
        },
        {
          "command": "russet.virtual.volumeDown",
          "group": "1_hardware@3",
          "when": "activeWebviewPanelId == 'russet.virtualIphone'"
        }
      ]
    },
    "debuggers": [
      {
        "type": "russet-virtual",
        "label": "Russet: Virtual iPhone",
        "languages": [
          "swift"
        ]
      },
      {
        "type": "russet",
        "label": "Russet: iPhone",
        "languages": [
          "swift",
          "objective-c",
          "c",
          "cpp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "target"
            ],
            "properties": {
              "target": {
                "type": "string",
                "description": "The product, scheme or target to build and launch."
              },
              "device": {
                "type": "string",
                "default": "auto",
                "description": "A UDID or `auto` to use the selected run destination."
              },
              "configuration": {
                "type": "string",
                "enum": [
                  "Debug",
                  "Release"
                ],
                "default": "Debug"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "env": {
                "type": "object",
                "default": {},
                "additionalProperties": {
                  "type": "string"
                }
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              },
              "build": {
                "type": "boolean",
                "default": true,
                "description": "Build before launching."
              }
            }
          },
          "attach": {
            "required": [
              "bundleId"
            ],
            "properties": {
              "bundleId": {
                "type": "string",
                "description": "The bundle identifier of the installed app to attach to."
              },
              "device": {
                "type": "string",
                "default": "auto"
              },
              "program": {
                "type": "string",
                "description": "The local .app or executable for source mapping."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "russet",
            "request": "launch",
            "name": "Run on iPhone",
            "device": "auto",
            "configuration": "Debug",
            "args": [],
            "env": {},
            "stopAtEntry": false,
            "build": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Russet: Launch on iPhone",
            "description": "Build, install and debug on a connected iPhone.",
            "body": {
              "type": "russet",
              "request": "launch",
              "name": "Run on iPhone",
              "target": "^\"${1:MyApp}\"",
              "device": "auto",
              "configuration": "Debug",
              "stopAtEntry": false,
              "build": true
            }
          },
          {
            "label": "Russet: Attach on iPhone",
            "description": "Attach to an app already installed on a connected iPhone.",
            "body": {
              "type": "russet",
              "request": "attach",
              "name": "Attach on iPhone",
              "bundleId": "^\"${1:com.example.MyApp}\"",
              "device": "auto"
            }
          }
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "swift"
      },
      {
        "language": "objective-c"
      },
      {
        "language": "c"
      },
      {
        "language": "cpp"
      }
    ],
    "taskDefinitions": [
      {
        "type": "russet",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "run",
              "test",
              "clean",
              "archive"
            ]
          },
          "target": {
            "type": "string"
          },
          "configuration": {
            "type": "string",
            "enum": [
              "Debug",
              "Release"
            ]
          },
          "device": {
            "type": "string"
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "russet.setup",
        "title": "Set up Russet",
        "description": "Build and run iOS apps on your iPhone without a Mac.",
        "steps": [
          {
            "id": "setup",
            "title": "Set up this PC",
            "description": "Russet installs its backend, USB support through Apple Devices, xtool and the iOS SDK for you, with progress and repair.\n[Open Setup](command:russet.openSetup)",
            "media": {
              "markdown": "media/walkthrough/setup.md"
            },
            "completionEvents": [
              "onContext:russet.setupOk"
            ],
            "when": "russet.windowsSetup"
          },
          {
            "id": "doctor",
            "title": "Check this computer",
            "description": "Run the Russet doctor to check your toolchain, daemon and device prerequisites.\n[Run Doctor](command:russet.doctor)",
            "media": {
              "markdown": "media/walkthrough/doctor.md"
            },
            "completionEvents": [
              "onContext:russet.doctorOk"
            ]
          },
          {
            "id": "toolchain",
            "title": "Install the matching Swift toolchain",
            "description": "Russet installs the Swift toolchain the SDK requires.\n[Open Setup](command:russet.openSetup)",
            "media": {
              "markdown": "media/walkthrough/toolchain.md"
            },
            "completionEvents": [
              "onContext:russet.toolchainOk"
            ]
          },
          {
            "id": "xcode",
            "title": "Import your Xcode",
            "description": "Download Xcode from Apple yourself, then choose the .xip. Russet reads the iOS SDK from it and never redistributes it.\n[Choose Xcode…](command:russet.importXcode)",
            "media": {
              "markdown": "media/walkthrough/xcode.md"
            },
            "completionEvents": [
              "onContext:russet.sdkOk"
            ]
          },
          {
            "id": "account",
            "title": "Sign in",
            "description": "Sign in with your Apple ID (free or paid), or add an App Store Connect API key.\n[Sign in with Apple ID…](command:russet.account.signInAppleId)\n[Add API Key…](command:russet.account.addAscKey)",
            "media": {
              "markdown": "media/walkthrough/account.md"
            },
            "completionEvents": [
              "onContext:russet.accountOk"
            ]
          },
          {
            "id": "device",
            "title": "Connect your iPhone",
            "description": "Connect your iPhone with USB and tap Trust. Enable Developer Mode when prompted.\n[Choose Run Destination](command:russet.selectDevice)\n[Run Doctor](command:russet.doctor)",
            "media": {
              "markdown": "media/walkthrough/device.md"
            },
            "completionEvents": [
              "onContext:russet.deviceReady"
            ]
          },
          {
            "id": "virtual",
            "title": "Create a virtual iPhone",
            "description": "Russet builds a virtual iPhone (iPhone17,3 with iOS 27.0.1 by default) that runs, installs and debugs like a real one, in an editor tab.\n[Create Virtual iPhone](command:russet.openSetup?%5B%22virtual-iphone%22%5D)\n[Open Virtual iPhone](command:russet.openVirtualIphone)",
            "media": {
              "markdown": "media/walkthrough/virtual.md"
            },
            "completionEvents": [
              "onContext:russet.virtualIphoneOk"
            ],
            "when": "russet.windowsSetup"
          },
          {
            "id": "project",
            "title": "Create or open a project",
            "description": "Open a Swift or Flutter project folder.\n[Open Folder](command:workbench.action.files.openFolder)",
            "media": {
              "markdown": "media/walkthrough/project.md"
            },
            "completionEvents": [
              "onContext:russet.projectKind"
            ]
          },
          {
            "id": "run",
            "title": "Run on your iPhone",
            "description": "Press Run to build, install and launch on your iPhone.\n[Run](command:russet.run)",
            "media": {
              "markdown": "media/walkthrough/run.md"
            },
            "completionEvents": [
              "onCommand:russet.run"
            ]
          },
          {
            "id": "agents",
            "title": "Optional: connect an AI agent",
            "description": "Connect an AI coding agent that can build and test on your device through Russet.\n[Open Agents](command:russet.agents.open)",
            "media": {
              "markdown": "media/walkthrough/agents.md"
            },
            "completionEvents": [
              "onView:russet.agents"
            ]
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "russet.mcp",
        "label": "Russet"
      }
    ],
    "authentication": [
      {
        "id": "russet-apple",
        "label": "Apple Developer (Russet)"
      }
    ],
    "problemMatchers": [
      {
        "name": "russet-swiftc",
        "owner": "russet",
        "source": "swiftc",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning|note): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "keybindings": [
      {
        "command": "russet.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "russet.projectKind && isWorkspaceTrusted"
      },
      {
        "command": "russet.stop",
        "key": "shift+f5",
        "mac": "shift+f5",
        "when": "russet.isRunning && !inDebugMode"
      },
      {
        "command": "russet.hotReload",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "russet.canHotReload"
      },
      {
        "command": "russet.hotRestart",
        "key": "ctrl+alt+shift+r",
        "mac": "cmd+alt+shift+r",
        "when": "russet.isRunning"
      },
      {
        "command": "russet.openMirror",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "russet.deviceReady"
      },
      {
        "command": "russet.agents.newSession",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "russet.featureAgents"
      },
      {
        "command": "russet.virtual.home",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "activeWebviewPanelId == 'russet.virtualIphone'"
      },
      {
        "command": "russet.virtual.lock",
        "key": "ctrl+shift+l",
        "mac": "cmd+l",
        "when": "activeWebviewPanelId == 'russet.virtualIphone'"
      },
      {
        "command": "russet.virtual.volumeUp",
        "key": "ctrl+shift+up",
        "mac": "cmd+shift+up",
        "when": "activeWebviewPanelId == 'russet.virtualIphone'"
      },
      {
        "command": "russet.virtual.volumeDown",
        "key": "ctrl+shift+down",
        "mac": "cmd+shift+down",
        "when": "activeWebviewPanelId == 'russet.virtualIphone'"
      },
      {
        "command": "russet.virtual.rotateLeft",
        "key": "ctrl+shift+left",
        "mac": "cmd+left",
        "when": "activeWebviewPanelId == 'russet.virtualIphone'"
      },
      {
        "command": "russet.virtual.rotateRight",
        "key": "ctrl+shift+right",
        "mac": "cmd+right",
        "when": "activeWebviewPanelId == 'russet.virtualIphone'"
      },
      {
        "command": "russet.virtual.screenshot",
        "key": "ctrl+shift+s",
        "mac": "cmd+s",
        "when": "activeWebviewPanelId == 'russet.virtualIphone'"
      }
    ],
    "configuration": {
      "title": "Russet",
      "properties": {
        "russet.binDir": {
          "type": "string",
          "default": "",
          "description": "Overrides the bundled or shim location of the `russet` binaries."
        },
        "russet.daemon.socketPath": {
          "type": "string",
          "default": "",
          "description": "Path to the russetd socket. Empty asks the CLI."
        },
        "russet.daemon.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the Russet daemon automatically when it is not running."
        },
        "russet.defaultDevice": {
          "type": "string",
          "default": "auto",
          "description": "A UDID or `auto`."
        },
        "russet.build.configuration": {
          "type": "string",
          "enum": [
            "Debug",
            "Release"
          ],
          "default": "Debug"
        },
        "russet.build.revealOutput": {
          "type": "string",
          "enum": [
            "always",
            "onError",
            "never"
          ],
          "default": "onError"
        },
        "russet.run.openConsole": {
          "type": "boolean",
          "default": true
        },
        "russet.run.openMirror": {
          "type": "boolean",
          "default": false
        },
        "russet.console.maxLines": {
          "type": "number",
          "default": 50000
        },
        "russet.console.defaultSources": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "app-stdout",
              "app-stderr",
              "oslog",
              "syslog"
            ]
          },
          "default": [
            "app-stdout",
            "app-stderr",
            "oslog"
          ]
        },
        "russet.mirror.codecs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "hevc",
              "avc",
              "jpeg",
              "poll"
            ]
          },
          "default": [
            "hevc",
            "avc",
            "jpeg",
            "poll"
          ]
        },
        "russet.mirror.maxFps": {
          "type": "number",
          "default": 60
        },
        "russet.mirror.showStats": {
          "type": "boolean",
          "default": false
        },
        "russet.account.appleIdSignIn": {
          "type": "string",
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Offer Apple ID sign-in when the Russet engine supports it.",
            "Always show the sign-in form, even if the engine does not report its sign-in libraries (development).",
            "Hide Apple ID sign-in; use App Store Connect API keys only."
          ],
          "default": "auto",
          "description": "Native Apple ID sign-in. Russet never stores your password in settings or in the IDE."
        },
        "russet.project.organizationIdentifier": {
          "type": "string",
          "default": "",
          "scope": "application",
          "pattern": "^$|^[A-Za-z][A-Za-z0-9-]*(\\.[A-Za-z0-9-]+)+$",
          "patternErrorMessage": "Use reverse-DNS, like com.yourname.",
          "markdownDescription": "Your reverse-DNS prefix for new apps' bundle IDs, like `com.yourname` (Xcode calls it the organization identifier). Russet asks for it the first time it needs it and saves it here. Apple never registers `com.example`."
        },
        "russet.account.anisetteServer": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "pattern": "^$|^https://S+$",
          "patternErrorMessage": "Use an https:// URL, or leave empty to use this PC's own identity.",
          "markdownDescription": "The Apple device-identity (anisette) server used when you sign in with an Apple ID. Empty: this PC creates its own identity locally. An `https://` URL (for example `https://mac-ani.jkcoxson.com`): that server provides the identity instead, and **its operator sees this computer's Apple device-identity requests** — not your Apple ID password or two-factor codes. Set in user settings only; a workspace cannot change it."
        },
        "russet.debug.adapter": {
          "type": "string",
          "enum": [
            "lldb-dap",
            "codelldb"
          ],
          "default": "lldb-dap"
        },
        "russet.debug.lldbDapPath": {
          "type": "string",
          "default": "",
          "description": "Overrides the lldb-dap path the daemon reports."
        },
        "russet.agents.registryUrl": {
          "type": "string",
          "default": "https://cdn.agentclientprotocol.com/registry/v1/latest/registry.json",
          "description": "Empty disables the fetch."
        },
        "russet.agents.custom": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object"
          }
        },
        "russet.agents.default": {
          "type": "string",
          "default": ""
        },
        "russet.agents.mcpTransport": {
          "type": "string",
          "enum": [
            "stdio",
            "http"
          ],
          "default": "stdio"
        },
        "russet.ai.endpoints": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object"
          },
          "description": "OpenAI-compatible endpoints; keys live in SecretStorage, never in settings."
        },
        "russet.mcp.registerWithVSCode": {
          "type": "boolean",
          "default": true
        },
        "russet.mcp.clientName": {
          "type": "string",
          "default": "vscode"
        }
      }
    },
    "languages": [
      {
        "id": "plist",
        "aliases": [
          "Property List",
          "plist"
        ],
        "extensions": [
          ".plist",
          ".entitlements",
          ".stringsdict",
          ".xcprivacy",
          ".mobileconfig"
        ],
        "firstLine": "^(<\\?xml[^>]*>\\s*)?<!DOCTYPE plist",
        "configuration": "./language-configuration/plist.json"
      },
      {
        "id": "strings",
        "aliases": [
          "Strings",
          "strings"
        ],
        "extensions": [
          ".strings"
        ],
        "configuration": "./language-configuration/c-style.json"
      },
      {
        "id": "openstep-plist",
        "aliases": [
          "Xcode Project",
          "OpenStep Property List"
        ],
        "extensions": [
          ".pbxproj"
        ],
        "configuration": "./language-configuration/c-style.json"
      },
      {
        "id": "xcconfig",
        "aliases": [
          "Xcode Build Configuration",
          "xcconfig"
        ],
        "extensions": [
          ".xcconfig"
        ],
        "configuration": "./language-configuration/xcconfig.json"
      },
      {
        "id": "modulemap",
        "aliases": [
          "Module Map",
          "modulemap"
        ],
        "extensions": [
          ".modulemap"
        ],
        "filenames": [
          "module.modulemap",
          "module.private.modulemap"
        ],
        "configuration": "./language-configuration/c-style.json"
      },
      {
        "id": "xml",
        "extensions": [
          ".storyboard",
          ".xib",
          ".xcscheme",
          ".xcworkspacedata",
          ".xcsettings",
          ".gpx",
          ".xcdatamodel",
          ".intentdefinition"
        ]
      },
      {
        "id": "json",
        "extensions": [
          ".xcstrings",
          ".xctestplan",
          ".xcappdata",
          ".ips",
          ".apns"
        ],
        "filenames": [
          "Package.resolved",
          "Contents.json"
        ]
      },
      {
        "id": "cpp",
        "extensions": [
          ".metal"
        ]
      },
      {
        "id": "yaml",
        "extensions": [
          ".tbd"
        ]
      },
      {
        "id": "objective-cpp",
        "extensions": [
          ".mm"
        ]
      }
    ],
    "grammars": [
      {
        "language": "plist",
        "scopeName": "text.xml.plist",
        "path": "./syntaxes/plist.tmLanguage.json"
      },
      {
        "language": "strings",
        "scopeName": "source.strings",
        "path": "./syntaxes/strings.tmLanguage.json"
      },
      {
        "language": "openstep-plist",
        "scopeName": "source.openstep-plist",
        "path": "./syntaxes/openstep-plist.tmLanguage.json"
      },
      {
        "language": "xcconfig",
        "scopeName": "source.xcconfig",
        "path": "./syntaxes/xcconfig.tmLanguage.json"
      },
      {
        "language": "modulemap",
        "scopeName": "source.modulemap",
        "path": "./syntaxes/modulemap.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "npm run compile:ext && npm run compile:webview",
    "compile:ext": "node esbuild.mjs",
    "compile:webview": "vite build",
    "watch": "node esbuild.mjs --watch",
    "compile:test": "node esbuild.mjs --tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:integration": "npm run compile && npm run compile:test && vscode-test",
    "test": "npm run test:unit",
    "pretest": "npm run compile && npm run typecheck",
    "package": "vsce package --no-dependencies -o russet.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-jsonrpc": "8.2.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/mocha": "10.0.10",
    "@types/node": "20.17.6",
    "@types/vscode": "1.134.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2",
    "vite": "6.0.7",
    "vitest": "2.1.9"
  }
}
