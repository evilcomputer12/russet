{
  "name": "russet",
  "publisher": "russet",
  "displayName": "Russet",
  "description": "Build, run and debug iOS apps on your iPhone from Linux and Windows, with the virtual iPhone embedded.",
  "version": "0.6.0",
  "license": "AGPL-3.0-only",
  "icon": "media/russet-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/evilcomputer12/russet"
  },
  "engines": {
    "vscode": "^1.135.0",
    "node": ">=20"
  },
  "categories": [
    "Debuggers",
    "Programming Languages",
    "Testing",
    "Other",
    "Themes"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Build, run, debug and agent tools are disabled until the workspace is trusted (Package.swift plugins and build scripts execute code)."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/Package.swift",
    "workspaceContains:**/xtool.yml",
    "workspaceContains:**/pubspec.yaml",
    "workspaceContains:**/*.xcodeproj/project.pbxproj",
    "workspaceContains:**/russet.toml",
    "onDebugResolve:russet",
    "onWebviewPanel:russet.mirror",
    "onWebviewPanel:russet.console",
    "onWebviewPanel:russet.setup",
    "onWebviewPanel:russet.virtualIphone",
    "onLanguage:plist",
    "onFileSystem:russet-plist",
    "onFileSystem:russet-profile"
  ],
  "contributes": {
    "configurationDefaults": {
      "window.autoDetectColorScheme": true,
      "workbench.colorTheme": "Russet Studio Dark (Xcode-style)",
      "workbench.preferredDarkColorTheme": "Russet Studio Dark (Xcode-style)",
      "workbench.preferredLightColorTheme": "Russet Studio Light (Xcode-style)",
      "editor.fontFamily": "'SF Mono', Menlo, 'Cascadia Mono', Consolas, 'Courier New', monospace",
      "window.menuBarVisibility": "compact",
      "window.commandCenter": true,
      "workbench.layoutControl.enabled": false,
      "workbench.activity.showAccounts": false,
      "workbench.tips.enabled": false,
      "workbench.startupEditor": "none",
      "workbench.editor.empty.hint": "hidden",
      "workbench.secondarySideBar.defaultVisibility": "hidden",
      "workbench.tree.indent": 12,
      "editor.minimap.enabled": false,
      "editor.stickyScroll.enabled": false,
      "editor.renderLineHighlight": "all",
      "extensions.ignoreRecommendations": true,
      "telemetry.telemetryLevel": "off"
    },
    "themes": [
      {
        "label": "Russet Studio Dark (Xcode-style)",
        "uiTheme": "vs-dark",
        "path": "./themes/russet-studio-dark-color-theme.json"
      },
      {
        "label": "Russet Studio Light (Xcode-style)",
        "uiTheme": "vs",
        "path": "./themes/russet-studio-light-color-theme.json"
      },
      {
        "label": "Russet Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/russet-dark-color-theme.json"
      },
      {
        "label": "Russet Light",
        "uiTheme": "vs",
        "path": "./themes/russet-light-color-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "russet",
          "title": "Russet",
          "icon": "media/russet.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "russet-aux",
          "title": "iPhone & Agents",
          "icon": "media/russet.svg"
        }
      ],
      "panel": [
        {
          "id": "russet-panel",
          "title": "Device Console",
          "icon": "media/console.svg"
        }
      ]
    },
    "views": {
      "russet": [
        {
          "id": "russet.devices",
          "name": "Devices"
        },
        {
          "id": "russet.project",
          "name": "Project"
        },
        {
          "id": "russet.runConfigs",
          "name": "Run Configurations"
        },
        {
          "id": "russet.signing",
          "name": "Signing"
        },
        {
          "id": "russet.agentActivity",
          "name": "Agent Activity",
          "visibility": "collapsed"
        }
      ],
      "russet-aux": [
        {
          "type": "webview",
          "id": "russet.mirror",
          "name": "iPhone"
        },
        {
          "type": "webview",
          "id": "russet.agents",
          "name": "Agents",
          "when": "russet.featureAgents"
        }
      ],
      "russet-panel": [
        {
          "type": "webview",
          "id": "russet.console",
          "name": "Console"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "russet.devices",
        "when": "russet.daemonConnected && !russet.hasDevice",
        "contents": "Connect an iPhone with a USB cable and tap Trust.\n[Run Doctor](command:russet.doctor)\n[Setup Guide](command:russet.openSetup)"
      },
      {
        "view": "russet.devices",
        "when": "!russet.daemonConnected",
        "contents": "Russet's background service is not running.\n[Start Russet Daemon](command:russet.daemon.start)"
      },
      {
        "view": "russet.project",
        "when": "russet.daemonConnected && !russet.projectKind",
        "contents": "Open a Swift, Flutter or Xcode project to get started.\n[Open Setup Guide](command:russet.openSetup)"
      }
    ],
