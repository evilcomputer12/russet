<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- The backend's secret-store passphrase, shared with the launcher (the setup page starts the daemon too). -->
    <Compile Include="..\Russet.Launcher\BackendSecrets.cs" Link="BackendSecrets.cs" />
  </ItemGroup>
</Project>
