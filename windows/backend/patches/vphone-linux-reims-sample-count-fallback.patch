diff --git a/reims-vgpu/crates/reims-vgpu-vulkan/src/gpu/samples.rs b/reims-vgpu/crates/reims-vgpu-vulkan/src/gpu/samples.rs
new file mode 100644
index 00000000..7186fc34
--- /dev/null
+++ b/reims-vgpu/crates/reims-vgpu-vulkan/src/gpu/samples.rs
@@ -0,0 +1,82 @@
+//! Sample counts a guest asks for that the device does not render at. An Apple9 GPU renders
+//! textures at 1, 2 and 4 samples, and iOS 27's system UI makes 2-sample depth textures whatever
+//! `supportsTextureSampleCount:` answers; lavapipe, the Vulkan driver vphone-linux runs on WSL,
+//! renders 1 and 4 only (`framebufferColorSampleCounts`, `framebufferDepthSampleCounts`), so the
+//! runtime refuses such a texture (`Unsupported`, `TextureSampleCount`) and the guest dies with it.
+//!
+//! Instead a count the device lacks is drawn at the next count it renders ([`drawn`]): a
+//! texture's (`TextureFields::of`, [`crate::gpu::desc`]), a render or tile state's
+//! `rasterSampleCount` ([`crate::gpu::serialized`]) and a pass's `defaultRasterSampleCount`
+//! ([`crate::gpu::desc`]) alike, so a pass's attachments and the states that draw into them keep
+//! agreeing, as Metal's must. What then differs from Metal's is relayed
+//! ([`Inexact::SampleCount`]): a texture's `sampleCount` and a function's `get_num_samples()`
+//! answer the count drawn, a resolve averages that many samples, and a function's `sample_mask`
+//! reaches the samples it names alone. A device that renders every count asked draws each as
+//! asked, and before a device is made ([`learn`]) every count is drawn as asked.
+
+use std::sync::atomic::{AtomicU8, Ordering};
+
+use metal2vulkan_runtime as rt;
+
+use crate::answer::{Inexact, inexact};
+
+/// The counts the process's first device renders textures at (`supportsTextureSampleCount:`),
+/// bit `n` for `2^n` samples; 0 before a device is made.
+static RENDERED: AtomicU8 = AtomicU8::new(0);
+
+/// Keeps the counts `device` renders textures at, where no device's are kept yet
+/// ([`crate::gpu::device::adopt`]).
+pub(crate) fn learn(device: &rt::Device) {
+    let props = device.properties();
+    let rendered = (0..8u32)
+        .filter(|&n| props.supports_texture_sample_count(1 << n) == Ok(true))
+        .fold(0u8, |mask, n| mask | 1 << n);
+    let _ = RENDERED.compare_exchange(0, rendered, Ordering::Relaxed, Ordering::Relaxed);
+}
+
+/// The count a texture, state or pass of `count` samples is drawn at ([`at`]), relayed at `sel`
+/// where it is not `count`.
+pub(crate) fn drawn<T: Copy + Into<u64> + TryFrom<u64>>(sel: &'static str, count: T) -> T {
+    let asked = count.into();
+    let drawn = at(RENDERED.load(Ordering::Relaxed), asked);
+    if drawn == asked {
+        return count;
+    }
+    inexact(sel, Inexact::SampleCount, || {
+        format!("{asked} samples, which the device does not render: drawn at {drawn}")
+    });
+    T::try_from(drawn).unwrap_or(count)
+}
+
+/// `count` where `rendered` (as [`RENDERED`]) holds it, is 0, or `count` is no power of two
+/// above 1; otherwise the next count above it that `rendered` holds, or `count` where none is,
+/// which the runtime refuses as before.
+fn at(rendered: u8, count: u64) -> u64 {
+    if rendered == 0 || count <= 1 || !count.is_power_of_two() || count >= 1 << 8 {
+        return count;
+    }
+    let n = count.trailing_zeros();
+    if rendered & (1 << n) != 0 {
+        return count;
+    }
+    (n + 1..8)
+        .find(|&m| rendered & (1 << m) != 0)
+        .map_or(count, |m| 1 << m)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::at;
+
+    #[test]
+    fn a_count_the_device_lacks_is_drawn_at_the_next_it_renders() {
+        let lavapipe = 0b101; // 1 and 4 samples
+        assert_eq!(at(lavapipe, 2), 4);
+        assert_eq!([at(lavapipe, 0), at(lavapipe, 1), at(lavapipe, 4)], [0, 1, 4]);
+        assert_eq!(at(lavapipe, 8), 8, "no count above it: refused as before");
+        assert_eq!(at(lavapipe, 3), 3, "no sample count");
+        let apple9 = 0b111;
+        assert_eq!([at(apple9, 1), at(apple9, 2), at(apple9, 4)], [1, 2, 4]);
+        assert_eq!(at(0, 2), 2, "before a device is made");
+    }
+}
