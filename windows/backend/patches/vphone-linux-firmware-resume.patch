+# An IPSW takes its name only once it arrived whole: curl writes FILE.part, and a later attempt
+# (or run) carries on from there; a connection that drops or stalls (under 1 KB/s for two
+# minutes) costs a retry, not the gigabytes received. Six attempts in a row that bring nothing
+# end the run, which carries on the same way when re-run. An IPSW is a zip, whose directory is at
+# its end: a cache file without one (cut short by an older run) goes back to FILE.part.
+is_zip() { python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).close()' "$1" 2>/dev/null; }
+fetch_firmware() {
+  local file=$1 url=$2 have rc idle=0
+  if [ -s "$file" ]; then
+    [ "$DRY" = 0 ] && [[ $file == "$CACHE"/* ]] && ! is_zip "$file" || return 0
+    log "  $(basename "$file") is incomplete: carrying on with its download"
+    mv -f "$file" "$file.part"
+  fi
+  if [ "$DRY" = 1 ]; then dry curl -fL -C - -o "$file.part" "$url"; return 0; fi
+  while :; do
+    have=$(stat -c %s "$file.part" 2>/dev/null || echo 0)
+    [ "$have" = 0 ] || log "  resuming $(basename "$file") at $((have / 1048576)) MiB"
+    rc=0
+    curl -fL --connect-timeout 30 --speed-limit 1024 --speed-time 120 -C - -o "$file.part" "$url" || rc=$?
+    [ "$rc" != 0 ] || break
+    # 33: the server ignored the range; start that file again.
+    [ "$rc" != 33 ] || rm -f "$file.part"
+    if [ "$(stat -c %s "$file.part" 2>/dev/null || echo 0)" -gt "$have" ]; then idle=0; else idle=$((idle + 1)); fi
+    [ "$idle" -lt 6 ] || die "$(basename "$file") did not download (curl exit $rc); check the connection, then re-run: it carries on where it stopped"
+    warn "the download of $(basename "$file") stopped (curl exit $rc); retrying in 10 s"
+    sleep 10
+  done
+  is_zip "$file.part" || { rm -f "$file.part"; die "$(basename "$file") arrived but is not a whole IPSW; re-run to download it again"; }
+  mv -f "$file.part" "$file"
+}
