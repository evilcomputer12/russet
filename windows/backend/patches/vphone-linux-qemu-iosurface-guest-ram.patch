From 969158bdef0bdb82a958ac652517ba351a2fcf24 Mon Sep 17 00:00:00 2001
From: evilcomputer12 <evilcomputer12@users.noreply.github.com>
Date: Fri, 30 Oct 2026 00:40:12 +0100
Subject: [PATCH 1/3] hw/display/apple-gfx: give the MMIO IOSurface device the
 guest-RAM files

apple_gfx_mmio_create_iosurface_device built the IOSurface device's memory
map with apple_gfx_new_memory_ranges(NULL) -- no files -- so on Linux the
library had no memfd behind the guest's RAM for that device. The display's
IOSurface descriptor table and command ring are mapped through it, and
without the memfd the library cannot make the shared views it remaps them
into, so the display stayed black while the guest's GPU driver looped
"Trying to restart GPU". The graphics device already passes the files.

The IOSurface device now passes them too, built the same way
(apple_gfx_new_memory_ranges(&files)) and validated by the same helper,
apple_gfx_memory_files, which is made non-static and declared in apple-gfx.h
for the MMIO unit. The new RvgIOSurfaceDeviceConfig.memory_files field is
additive and struct_size-versioned, so the library keeps its old behaviour
for a host that does not pass it.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 hw/display/apple-gfx-mmio.c | 21 ++++++++++++++++++---
 hw/display/apple-gfx.c      |  6 +++---
 hw/display/apple-gfx.h      | 10 ++++++++++
 3 files changed, 31 insertions(+), 6 deletions(-)

diff --git a/qemu/hw/display/apple-gfx-mmio.c b/qemu/hw/display/apple-gfx-mmio.c
index 2e639d340a..d5a50dbb88 100644
--- a/qemu/hw/display/apple-gfx-mmio.c
+++ b/qemu/hw/display/apple-gfx-mmio.c
@@ -98,8 +98,17 @@ static void apple_gfx_mmio_iosfc_raise_interrupt_cb(void *ctx, uint32_t vector)
 static bool apple_gfx_mmio_create_iosurface_device(AppleGFXMMIOState *s,
                                                    Error **errp)
 {
-    /* The library copies the ranges. */
-    g_autoptr(GArray) memory_ranges = apple_gfx_new_memory_ranges(NULL);
+    /*
+     * The library copies the ranges and duplicates the files' descriptors.
+     * vphone-linux: the IOSurface device must get the files (the guest-RAM
+     * memfd behind each range), as the graphics device does, or on Linux it
+     * cannot map the guest's IOSurface descriptor table and ring (the display
+     * stays black). Same ranges as apple_gfx_common_realize built, so the
+     * memory-backend-memfd check there has already passed.
+     */
+    g_autoptr(GArray) memory_files = NULL;
+    g_autoptr(GArray) memory_ranges = apple_gfx_new_memory_ranges(&memory_files);
+    const RvgMemoryRangeFile *files = NULL;
     RvgMemoryMap memory_map = {
         .ranges = (const RvgMemoryRange *)memory_ranges->data,
         .range_count = memory_ranges->len,
@@ -109,13 +118,19 @@ static bool apple_gfx_mmio_create_iosurface_device(AppleGFXMMIOState *s,
         .ctx = s,
         .raise_interrupt = apple_gfx_mmio_iosfc_raise_interrupt_cb,
     };
+    RvgStatus status;
+
+    if (!apple_gfx_memory_files(memory_ranges, memory_files, &files, errp)) {
+        return false;
+    }
+
     RvgIOSurfaceDeviceConfig config = {
         .struct_size = sizeof(config),
         .memory_map = &memory_map,
         .callbacks = &callbacks,
         .guest_page_shift = s->guest_page_shift,
+        .memory_files = files,
     };
-    RvgStatus status;
 
     status = rvg_iosurface_device_create(&config, &s->pgiosfc);
     if (status != RVG_OK) {
diff --git a/qemu/hw/display/apple-gfx.c b/qemu/hw/display/apple-gfx.c
index c61ecb1ff8..457221047a 100644
--- a/qemu/hw/display/apple-gfx.c
+++ b/qemu/hw/display/apple-gfx.c
@@ -678,9 +678,9 @@ GArray *apple_gfx_new_memory_ranges(GArray **files)
  * On Linux the library builds its views of guest pages from these files, so
  * there a range without one fails the realize.
  */
-static bool apple_gfx_memory_files(GArray *ranges, GArray *files,
-                                   const RvgMemoryRangeFile **memory_files,
-                                   Error **errp)
+bool apple_gfx_memory_files(GArray *ranges, GArray *files,
+                            const RvgMemoryRangeFile **memory_files,
+                            Error **errp)
 {
     guint i;
 
diff --git a/qemu/hw/display/apple-gfx.h b/qemu/hw/display/apple-gfx.h
index acac83f5a3..361f0a0379 100644
--- a/qemu/hw/display/apple-gfx.h
+++ b/qemu/hw/display/apple-gfx.h
@@ -118,6 +118,16 @@ void apple_gfx_activity_end(void);
  */
 GArray *apple_gfx_new_memory_ranges(GArray **files);
 
+/*
+ * Validates @files (one RvgMemoryRangeFile per range of @ranges) and, on
+ * success, points *@memory_files at them. On Linux a range without a shared
+ * file mapping is an error; elsewhere *@memory_files is set to NULL (the files
+ * are not used). Shared by the graphics device and the MMIO IOSurface device.
+ */
+bool apple_gfx_memory_files(GArray *ranges, GArray *files,
+                            const RvgMemoryRangeFile **memory_files,
+                            Error **errp);
+
 extern const PropertyInfo qdev_prop_apple_gfx_display_mode;
 
 #endif
-- 
