+    /// vphone-linux: WSLg brings no motion while a button is held (microsoft/wslg#1300): a press
+    /// and a release elsewhere are replayed as the drag between them, button held, then released;
+    /// a drag that did bring motion is sent as it came.
+    #[test]
+    fn a_drag_without_motion_is_replayed_as_a_swipe() {
+        let mut input = focused();
+        input.no_capture = true;
+        input.button_down(BUTTON_LEFT, 1_000_000_000, &at((80.0, 25.0)));
+        input.button_up(BUTTON_LEFT, &at((40.0, 25.0)));
+        let sent = input.take();
+        assert_eq!(sent.first(), Some(&pointer(160, 50, BUTTON_LEFT)));
+        assert_eq!(sent.len(), 1 + REPLAY_STEPS as usize + 1);
+        assert_eq!(sent[REPLAY_STEPS as usize], pointer(80, 50, BUTTON_LEFT));
+        assert_eq!(sent.last(), Some(&pointer(80, 50, 0)));
+
+        input.button_down(BUTTON_LEFT, 2_000_000_000, &at((80.0, 25.0)));
+        input.moved(&at((60.0, 25.0)));
+        input.button_up(BUTTON_LEFT, &at((40.0, 25.0)));
+        assert_eq!(
+            input.take(),
+            vec![pointer(160, 50, BUTTON_LEFT), pointer(120, 50, BUTTON_LEFT), pointer(80, 50, 0)]
+        );
+
+        input.button_down(BUTTON_LEFT, 3_000_000_000, &at((80.0, 25.0)));
+        input.button_up(BUTTON_LEFT, &at((81.0, 25.0)));
+        assert_eq!(input.take().len(), 2, "a tap stays a tap");
+    }
+
