From 5940b611d5a2151b6674f0e01281957317af443f Mon Sep 17 00:00:00 2001
From: evilcomputer12 <evilcomputer12@users.noreply.github.com>
Date: Fri, 30 Oct 2026 00:40:29 +0100
Subject: [PATCH 2/3] hw/display/apple-gfx: REIMS_VGPU_ALLOW_MIGRATE drops the
 migration blocker

A debug aid for snapshot/restore of a VM state captured before the guest
has driven the GPU: with REIMS_VGPU_ALLOW_MIGRATE=1 the device does not add
its migration blocker, so the state can be saved with migrate and restored
into a fresh process. The default keeps the blocker, as before. The device
still has no VMStateDescription, so a restore is only sound before the guest
drives the GPU; a live resume needs the reims suspend/resume integration
noted in apple_gfx_common_realize.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 hw/display/apple-gfx.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/qemu/hw/display/apple-gfx.c b/qemu/hw/display/apple-gfx.c
index 457221047a..aadc750bdc 100644
--- a/qemu/hw/display/apple-gfx.c
+++ b/qemu/hw/display/apple-gfx.c
@@ -1031,7 +1031,15 @@ bool apple_gfx_common_realize(AppleGFXState *s, DeviceState *dev,
         return false;
     }
 
-    if (apple_gfx_mig_blocker == NULL) {
+    /*
+     * vphone-linux: REIMS_VGPU_ALLOW_MIGRATE=1 drops the migration blocker so
+     * the VM can be snapshot/migrated (debug fast-resume). The device still has
+     * no VMStateDescription, so this is sound only when the guest has not yet
+     * driven the GPU (a pre-graphics snapshot restored into a fresh process);
+     * a post-graphics snapshot needs reims suspend/resume wired (the TODO in
+     * apple_gfx_common_realize). Default: blocker stays, as upstream.
+     */
+    if (apple_gfx_mig_blocker == NULL && getenv("REIMS_VGPU_ALLOW_MIGRATE") == NULL) {
         error_setg(&apple_gfx_mig_blocker,
                   "Migration state blocked by apple-gfx display device");
         if (migrate_add_blocker(&apple_gfx_mig_blocker, errp) < 0) {
