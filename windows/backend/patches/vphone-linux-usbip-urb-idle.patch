 URB_TIMEOUT = float(os.environ.get("VUSB_URB_TIMEOUT", "30"))
+# Data endpoints wait the way real USB does. A NAK means the guest is alive with nothing to send:
+# the RestoreOS leaves the mux silent for minutes while apfs_invert copies the system volume, so
+# NAKs keep a data URB alive for up to URB_IDLE_TIMEOUT. During apfs_invert the guest does not even
+# NAK: its controller goes silent for many minutes under emulation, so silence ends a data URB only
+# after URB_STALL_TIMEOUT (the same hour by default). A QEMU that exits closes the chardev, which
+# unplugs the device at once.
+URB_STALL_TIMEOUT = float(os.environ.get("VUSB_URB_STALL_TIMEOUT", "3600"))
+URB_IDLE_TIMEOUT = float(os.environ.get("VUSB_URB_IDLE_TIMEOUT", "3600"))
 
 
